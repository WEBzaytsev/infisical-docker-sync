# Обязательный токен для связи агента с recreate-proxy.
# Сгенерировать: openssl rand -hex 32
PROXY_TOKEN=replace-with-a-random-64-character-hex-token

# GID группы Docker socket на хосте.
# Проверить: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Необязательно: подробные логи recreate-proxy.
# Для включения: RECREATE_PROXY_DEBUG=true
RECREATE_PROXY_DEBUG=false
